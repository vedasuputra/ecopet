# Server only (no VITE_ prefix): never exposed to the browser
GEMINI_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser-safe
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: real Google Ad Manager ad unit paths after approval (defaults to Google's sample units)
VITE_GPT_BANNER_UNIT=
VITE_GPT_REWARDED_UNIT=
# Optional, server only: let ANY account use the /dev tools (demo accounts @ecopet.demo always can). Leave unset in production.
ALLOW_DEV_ECONOMY=

# Optional, server only: chat limits that protect the free Gemini quota (defaults: 8 per minute, 100 per user per day, 1200 per day overall)
CHAT_PER_MINUTE=
CHAT_PER_DAY=
CHAT_GLOBAL_PER_DAY=

# Optional: your own Ad Manager video ad tag for the rewarded ad (defaults to Google's sample portrait tag)
VITE_IMA_AD_TAG=
