# Server only (no VITE_ prefix): never exposed to the browser
GEMINI_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser-safe
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: real Google Ad Manager ad unit paths after approval (defaults to Google's sample units)
VITE_GPT_BANNER_UNIT=
VITE_GPT_REWARDED_UNIT=
# Optional, server only: let ANY account use the /dev tools (demo accounts @ecopet.demo always can). Leave unset in production.
ALLOW_DEV_ECONOMY=

# Optional, server only: quest photo checks and itinerary planning (defaults in brackets)
# QUEST_PER_DAY (5) quests a traveler can finish per day; VERIFY_PER_MINUTE (4) / VERIFY_PER_DAY (30) / VERIFY_GLOBAL_PER_DAY (100) AI photo checks
QUEST_PER_DAY=
VERIFY_PER_MINUTE=
VERIFY_PER_DAY=
VERIFY_GLOBAL_PER_DAY=
# ITINERARY_PER_MINUTE (4) / ITINERARY_PER_DAY (30) / ITINERARY_GLOBAL_PER_DAY (100) AI itinerary plans
ITINERARY_PER_MINUTE=
ITINERARY_PER_DAY=
ITINERARY_GLOBAL_PER_DAY=

# Optional, server only: chat limits that protect the free Gemini quota (defaults: 8 per minute, 100 per user per day, 200 per day overall)
CHAT_PER_MINUTE=
CHAT_PER_DAY=
CHAT_GLOBAL_PER_DAY=

# Optional: your own Ad Manager video ad tag for the rewarded ad (defaults to Google's sample portrait tag)
VITE_IMA_AD_TAG=
